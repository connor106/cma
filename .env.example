# Slack app tokens. Use Socket Mode (no public request URL).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Optional. Limit replies to one channel. Use the channel ID (C...), not the name.
# Leave unset to answer in every channel the bot has been invited to.
CMA_SLACK_CHANNEL_ID=

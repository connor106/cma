# Slack app tokens. Use Socket Mode (no public request URL).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Answers in this channel name only. #deals is never used.
CMA_SLACK_CHANNEL=grokbot

# Optional channel ID for #grokbot, used only when Slack does not return the channel name.
CMA_SLACK_CHANNEL_ID=
